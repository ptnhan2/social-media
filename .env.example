# ============================================
# Handdraw Video Pipeline — API Keys
# Copy to .env and fill in your keys. DO NOT commit .env!
# ============================================

# Pixabay API (free) — illustration search
# Get key: https://pixabay.com/api/docs/ → sign up → grab key
PIXABAY_API_KEY=your_pixabay_key_here

# ElevenLabs — voiceover TTS
# Your existing key
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# GLM-5.2 / Zhipu AI — LLM authors HyperFrames composition (PRIMARY)
# Coding plan endpoint. Your existing key for KiloCode.
ZHIPU_API_KEY=your_zhipu_key_here
ZHIPU_CODING_ENDPOINT=https://open.bigmodel.cn/api/coding/paas/v4

# DeepSeek — fallback if Zhipu fails/times out
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# HyperFrames — Windows renderer needs system Chrome path
# Puppeteer's chrome-headless-shell has EFTYPE issue on this machine
HYPERFRAMES_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional: AI image generation fallback (when Pixabay has no match)
# Flux Schnell on Replicate — ~$0.003/image
# Get key: https://replicate.com/account/api-tokens
REPLICATE_API_KEY=your_replicate_key_here

# Groq — FREE Whisper word timestamps (2000 req/day)
# Fallback if ElevenLabs with-timestamps endpoint unavailable
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
