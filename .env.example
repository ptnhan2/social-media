# === Required ===
DEEPSEEK_API_KEY=your-deepseek-key
ZHIPU_API_KEY=your-zhipu-key

# === LangSmith (tracing + evals) ===
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=isaacverse-harness

# === Optional: Override default model ===
# HARNESS_MODEL=deepseek:deepseek-chat
# HARNESS_MODEL=openai:glm-4-flash      (Zhipu, via OPENAI_BASE_URL)
# HARNESS_MODEL=dashscope:qwen-plus      (Qwen via DashScope)
# EVAL_JUDGE_MODEL=deepseek:deepseek-chat

# === Harness VLM (visual critique) — provider chain with auto-fallback ===
# VLM_PROVIDER=dashscope (Qwen3-VL, native video — STRONGEST) | zhipu | openrouter
VLM_PROVIDER=dashscope
VLM_MODEL=qwen3-vl-flash
# DASHSCOPE key region:
#   international (Singapore): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   China:                      https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Max POST body (KB) for native video input — China endpoint resets >~64KB from
# some international routes. Set 0 to disable the limit (clean intl route).
VLM_MAX_BODY_KB=60
VLM_VIDEO_FPS=10

# === Postgres (production only — dev uses in-memory) ===
# DATABASE_URL=postgresql://harness:harness_dev@localhost:5432/harness
POSTGRES_PASSWORD=harness_dev
