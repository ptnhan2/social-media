# === Harness Environment Variables ===

# LLM (required — DeepSeek for reasoning + tool calling)
DEEPSEEK_API_KEY=your-deepseek-key

# VLM (required — vision model for visual_critique)
# Priority: ZHIPU > GOOGLE > OPENAI > OPENROUTER
ZHIPU_API_KEY=your-zhipu-key
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Harness model override (default: deepseek:deepseek-chat)
# HARNESS_MODEL=deepseek:deepseek-chat

# Postgres (for production store — dev uses FileBackedStore)
# POSTGRES_URL=postgresql://harness:harness_dev@localhost:5432/harness
POSTGRES_PASSWORD=harness_dev

# === Optional media generation keys ===
# ELEVENLABS_API_KEY=
# PIXABAY_API_KEY=
# FAL_KEY=
# REPLICATE_API_KEY=
