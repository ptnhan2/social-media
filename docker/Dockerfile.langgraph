FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg nodejs npm git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy harness requirements and install
COPY harness/ ./harness/
RUN python -m venv harness/.venv \
    && harness/.venv/bin/pip install --no-cache-dir \
    deepagents langchain-deepseek langgraph-cli[inmem] langchain langgraph jsonschema

# Copy project files
COPY langgraph.json ./
COPY libraries/ ./libraries/
COPY remotion-composer/ ./remotion-composer/
COPY tools/ ./tools/
COPY projects/ ./projects/

# Copy .env (will be overridden by docker-compose env_file)
COPY .env ./

EXPOSE 2024

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:2024/ok')" || exit 1

CMD ["harness/.venv/bin/python", "-m", "langgraph_cli", "dev", "--host", "0.0.0.0", "--port", "2024"]
