FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg nodejs npm git curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY harness/ ./harness/
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir \
    "deepagents[video]" langchain-deepseek langgraph-cli[inmem] langchain langgraph langsmith openevals pillow langchain-openai langgraph-checkpoint-postgres "psycopg[binary]"

ENV PATH="/opt/venv/bin:$PATH"

COPY langgraph.json ./
COPY libraries/ ./libraries/
COPY remotion-composer/package*.json ./remotion-composer/
COPY remotion-composer/tsconfig.json ./remotion-composer/
COPY remotion-composer/scripts/ ./remotion-composer/scripts/
COPY remotion-composer/shared/ ./remotion-composer/shared/
COPY remotion-composer/public/ ./remotion-composer/public/
COPY remotion-composer/composer-app/ ./remotion-composer/composer-app/
COPY remotion-composer/build/ ./remotion-composer/build/
COPY tools/ ./tools/
COPY projects/ ./projects/

RUN cd remotion-composer && npm install

EXPOSE 2024

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:2024/ok || exit 1

CMD ["python", "-m", "langgraph_cli", "dev", "--host", "0.0.0.0", "--port", "2024"]
