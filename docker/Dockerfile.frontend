FROM node:20-slim AS builder

WORKDIR /app
COPY remotion-composer/composer-app/package*.json ./
RUN npm install
COPY remotion-composer/composer-app/ ./
COPY remotion-composer/shared/ ./../shared/
COPY remotion-composer/tsconfig.json ./../tsconfig.json
RUN npx vite build || true

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
