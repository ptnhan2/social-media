   "cost_usd": 0.0384,
   "ok": true
  },
  {
   "idx": 92,
   "text": "The AI is so good at deus ex machina, it needs a detector.",
   "params": {
    "speed": 0.95,
    "style": 0.3,
    "stability": 0.6,
    "pause_after": 0.12,
    "tag": "norm"
   },
