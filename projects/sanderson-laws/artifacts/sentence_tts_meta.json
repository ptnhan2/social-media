    "tag": "norm"
   },
   "path": "C:\\DevWork\\social-media\\openmontage\\projects\\sanderson-laws\\assets\\audio\\sentences\\s5_s70.mp3",
   "duration": 2.4,
   "cost_usd": 0.0147,
   "ok": true
  },
  {
