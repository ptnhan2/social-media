   },
   "path": "C:\\DevWork\\social-media\\openmontage\\projects\\sanderson-laws\\assets\\audio\\sentences\\s6_s88.mp3",
   "duration": 1.76,
   "cost_usd": 0.0072,
   "ok": true
  },
  {
   "idx": 89,
   "text": "But AI magic has an infinite warehouse.",
