   "duration": 1.92,
   "cost_usd": 0.0039,
   "ok": true
  },
  {
   "idx": 63,
   "text": "This one breaks my heart, because it's the difference between a system and a prop.",
   "params": {
    "speed": 0.95,
    "style": 0.3,
    "stability": 0.6,
    "pause_after": 0.12,
