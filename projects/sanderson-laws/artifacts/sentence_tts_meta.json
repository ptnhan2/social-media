    "style": 0.3,
    "stability": 0.6,
    "pause_after": 0.12,
    "tag": "norm"
   },
   "path": "C:\\DevWork\\social-media\\openmontage\\projects\\sanderson-laws\\assets\\audio\\sentences\\s6_s74.mp3",
   "duration": 3.04,
   "cost_usd": 0.0141,
   "ok": true
  },
  {
   "idx": 75,
   "text": "It's sworn.",
