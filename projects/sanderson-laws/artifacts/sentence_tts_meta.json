    "style": 0.55,
    "stability": 0.45,
    "pause_after": 0.55,
    "tag": "punch"
   },
   "path": "C:\\DevWork\\social-media\\openmontage\\projects\\sanderson-laws\\assets\\audio\\sentences\\s6_s75.mp3",
   "duration": 1.12,
   "cost_usd": 0.0033,
   "ok": true
  },
  {
   "idx": 76,
   "text": "You bond a spren, you speak oaths, and if you break an oath, the bond snaps and the spren dies.",
