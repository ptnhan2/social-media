   },
   "path": "C:\\DevWork\\social-media\\openmontage\\projects\\sanderson-laws\\assets\\audio\\sentences\\s6_s76.mp3",
   "duration": 6.64,
   "cost_usd": 0.0285,
   "ok": true
  },
  {
   "idx": 77,
   "text": "There are blades in that world that are literally the corpses of broken promises.",
