    "stability": 0.6,
    "pause_after": 0.12,
    "tag": "norm"
   },
   "path": "C:\\DevWork\\social-media\\openmontage\\projects\\sanderson-laws\\assets\\audio\\sentences\\s6_s77.mp3",
   "duration": 4.24,
   "cost_usd": 0.0243,
   "ok": true
  },
  {
   "idx": 78,
   "text": "That's consequence architecture.",
   "params": {
    "speed": 0.95,
    "style": 0.3,
    "stability": 0.6,
    "pause_after": 0.12,
    "tag": "norm"
   },
   "path": "C:\\DevWork\\social-media\\openmontage\\projects\\sanderson-laws\\assets\\audio\\sentences\\s6_s78.mp3",
   "duration": 1.76,
   "cost_usd": 0.0096,
   "ok": true
  },
  {
   "idx": 79,
   "text": "AI, though?",
