    "speed": 0.95,
    "style": 0.3,
    "stability": 0.6,
    "pause_after": 0.12,
    "tag": "norm"
   },
   "path": "C:\\DevWork\\social-media\\openmontage\\projects\\sanderson-laws\\assets\\audio\\sentences\\s6_s87.mp3",
   "duration": 6.64,
   "cost_usd": 0.0321,
   "ok": true
  },
  {
   "idx": 88,
   "text": "Magic has supply chains.",
   "params": {
