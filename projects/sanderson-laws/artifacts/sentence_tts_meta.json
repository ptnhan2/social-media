    "style": 0.3,
    "stability": 0.6,
    "pause_after": 0.12,
    "tag": "norm"
   },
   "path": "C:\\DevWork\\social-media\\openmontage\\projects\\sanderson-laws\\assets\\audio\\sentences\\s6_s86.mp3",
   "duration": 1.84,
   "cost_usd": 0.0105,
   "ok": true
  },
  {
   "idx": 87,
   "text": "Stormlight leaks out of your body, and during the Weeping, the weeks of endless rain, it runs out entirely.",
